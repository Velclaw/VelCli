<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tài liệu – VelCli</title>
<meta name="description" content="Tài liệu VelCli: AI Agent, Workspace, VelclawHost, VelcliHub và Plugins.">
<meta name="theme-color" content="#000000">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cpolygon points='2,8 20,8 32,38 46,8 62,8 38,60 26,60' fill='%234f6bff'/%3E%3C/svg%3E">
<style>
:root{--bg:#000;--card:#0a0a0a;--line:#222;--tx:#ededed;--mu:#9a9a9a;--ac:#3b82f6;--code:#050505;--hi:rgba(59,130,246,.18);--k:#f472b6;--s:#7cc4ff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 112px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:14.5px/1.75 ui-monospace,"SF Mono",Menlo,Consolas,monospace}
a{color:inherit}button{font:inherit;color:inherit;cursor:pointer}
.mono,code,pre{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:10px;height:56px;padding:0 16px;max-width:1200px;margin:auto}
.brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:20px;text-decoration:none}
.ver{border:1px solid var(--line);background:var(--card);border-radius:99px;padding:2px 10px;font-size:12px;color:var(--mu)}
.sp{flex:1}
.ib{width:36px;height:36px;border:0;background:none;border-radius:10px;display:grid;place-items:center;font-size:18px;color:var(--mu)}
.ib:hover{background:var(--card)}
.crumb{display:flex;align-items:center;gap:10px;height:44px;padding:0 16px;max-width:1200px;margin:auto;font-size:14px;color:var(--mu);border-top:1px solid var(--line)}
.crumb b{color:var(--tx);font-weight:500}
.shell{max-width:1200px;margin:auto;display:block}
.side{position:fixed;inset:0 auto 0 0;width:280px;max-width:84vw;background:var(--bg);border-right:1px solid var(--line);padding:calc(16px + env(safe-area-inset-top,0px)) 16px 24px;overflow-y:auto;transform:translateX(-100%);transition:transform .2s;z-index:30}
.side.open{transform:none}
.veil{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:25}
.side h4{margin:18px 0 6px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mu)}
.side a{display:block;padding:7px 12px;border-radius:8px;color:var(--mu);text-decoration:none;font-size:15px}
.side a.on{background:var(--hi);color:var(--ac);font-weight:600}
.side a:hover{color:var(--tx)}
main{padding:24px 20px 32px;max-width:760px;margin:auto}
h1{font-size:28px;line-height:1.15;margin:0 0 12px;letter-spacing:-.8px}
.lead{color:var(--mu);font-size:17px;margin:0 0 28px}
h2{font-size:21px;margin:32px 0 14px}
h3{font-size:16px;margin:0 0 4px}
p{margin:0 0 12px;color:var(--mu)}
code{background:var(--code);border:1px solid var(--line);border-radius:6px;padding:1px 6px;font-size:.88em;color:var(--tx)}
.tabs{display:flex;gap:4px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:20px}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;padding:10px 12px;color:var(--mu);white-space:nowrap;font-size:15px}
.tabs button.on{color:var(--tx);border-color:var(--tx);font-weight:600}
.step{display:flex;gap:16px;margin:26px 0}
.num{flex:none;height:26px;font:12px ui-monospace,Menlo,monospace;color:var(--mu);padding:2px 7px;border:1px solid var(--line);border-width:1px 0 1px 0;position:relative;margin-top:2px}
.num::before,.num::after{content:"";position:absolute;top:-1px;bottom:-1px;width:5px;border:1px solid var(--line)}
.num::before{left:-1px;border-right:0;border-radius:4px 0 0 4px}.num::after{right:-1px;border-left:0;border-radius:0 4px 4px 0}
.step>div{min-width:0;flex:1}
.term{margin:12px 0;border:1px solid var(--line);background:var(--code);border-radius:14px;overflow:hidden}
.th{display:flex;align-items:center;justify-content:space-between;padding:8px 14px;font-size:12.5px;color:var(--mu)}
.cp{background:none;border:0;color:var(--mu);font-size:15px;padding:2px 6px;border-radius:6px}
.cp:hover{color:var(--tx)}
pre{margin:0;padding:6px 0 12px;overflow-x:auto;font-size:13.5px;line-height:1.7}
pre i{display:block;font-style:normal;padding:0 16px;white-space:pre;min-height:1.7em}
pre i.h{background:var(--hi);box-shadow:inset 3px 0 var(--ac)}
.k{color:var(--k)}.s{color:var(--s)}
.note{border:1px solid var(--line);border-left:3px solid var(--ac);background:var(--card);border-radius:10px;padding:10px 14px;font-size:14px;color:var(--mu);margin:20px 0}
.pn{display:flex;gap:12px;margin-top:40px;padding-top:20px;border-top:1px solid var(--line)}
.pn a{flex:1;border:1px solid var(--line);border-radius:12px;padding:12px 14px;text-decoration:none;font-size:14px;color:var(--mu)}
.pn a b{display:block;color:var(--tx);font-size:15px}.pn a:last-child{text-align:right}
footer{border-top:1px solid var(--line);padding:28px 20px;max-width:760px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:20px;font-size:14px}
footer h5{margin:0 0 8px;font-size:14px}footer a{display:block;color:var(--mu);text-decoration:none;padding:4px 0}
.search{position:fixed;inset:0;z-index:40;background:var(--bg);padding:calc(14px + env(safe-area-inset-top,0px)) 16px 16px;overflow-y:auto}
.search input{width:100%;padding:14px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--tx);font:inherit}
.search a{display:block;padding:12px 6px;border-bottom:1px solid var(--line);text-decoration:none}
.search small{display:block;color:var(--mu)}
[hidden]{display:none!important}
@media (min-width:900px){
 .shell{display:grid;grid-template-columns:260px 1fr}
 .side{position:sticky;top:104px;inset:auto;transform:none;width:auto;max-width:none;height:calc(100vh - 104px);border:0;padding:24px 8px 24px 16px;z-index:1}
 .veil,.mb{display:none!important}
 main{margin:0;padding:36px 40px}
 footer{margin:0 0 0 260px;max-width:none}
}
</style>
</head>
<body>
<div class="top">
 <div class="bar">
  <a class="brand" href="index.html"><svg width="28" height="28" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2f7bff"/><stop offset="1" stop-color="#8b3dff"/></linearGradient></defs><polygon points="2,8 20,8 32,38 46,8 62,8 38,60 26,60" fill="url(#g)"/></svg>VelCli</a>
  <span class="ver mono">v1.0</span><span class="sp"></span>
  <button class="ib" id="so" aria-label="Tìm kiếm">⌕</button>
  <a class="ib" href="https://github.com/Velclaw/VelCli" aria-label="GitHub" style="text-decoration:none">⎇</a>
 </div>
 <div class="crumb"><button class="ib mb" id="mo" aria-label="Mở menu" style="width:30px;height:30px">☰</button><span id="bc"></span></div>
</div>
<div class="shell">
 <aside class="side" id="side"></aside>
 <div><main id="doc"></main>
 <footer>
  <div><h5>VelCli</h5><a href="index.html">Trang chủ</a><a href="#/start">Tài liệu</a><a href="https://velcli.dev">velcli.dev</a></div>
  <div><h5>Cộng đồng</h5><a href="https://github.com/Velclaw/VelCli">GitHub</a><a href="#/hub">VelcliHub</a></div>
 </footer></div>
</div>
<div class="veil" id="veil" hidden></div>
<div class="search" id="sr" hidden><div style="display:flex;gap:8px"><input id="si" placeholder="Tìm trong tài liệu…" autocomplete="off"><button class="ib" id="sc" aria-label="Đóng">✕</button></div><div id="sl"></div></div>
<script>
const $=s=>document.querySelector(s);
const T=(l,c,hi)=>({l,c,hi});
const P=[
{id:'start',g:'Bắt đầu',t:'Bắt đầu nhanh',lead:'VelCli biến mô tả bằng lời thành ứng dụng chạy thật, từ điện thoại hay máy tính.',tabs:[
 {n:'Dùng Web',i:'Cách nhanh nhất là tạo ứng dụng trực tiếp trên <b>velcli.dev</b>, không cần cài gì.',s:[
  {t:'Mô tả ứng dụng',p:'Mở velcli.dev, chọn <b>Tạo ứng dụng mới</b> và nhập yêu cầu.',c:T('Prompt','Tạo một trang web portfolio với Next.js và Tailwind')},
  {t:'Xem trước',p:'Khi AI Agent báo hoàn tất, bấm <b>Preview</b> để xem kết quả ngay.'},
  {t:'Triển khai',p:'Mở <b>VelclawHost</b>, chọn nhánh <code>main</code> rồi bấm <b>Deploy</b>.'}]},
 {n:'Dùng CLI',i:'Dùng dòng lệnh nếu bạn muốn làm việc trong môi trường cục bộ.',s:[
  {t:'Cài đặt',p:'Cài VelCli bằng npm.',c:T('Terminal','npm install -g velcli')},
  {t:'Khởi tạo dự án',p:'Tạo dự án mới và vào thư mục.',c:T('Terminal','velcli init my-app\ncd my-app')},
  {t:'Chạy thử',p:'Khởi động máy chủ phát triển.',c:T('Terminal','npm run dev')}]},
 {n:'Template',i:'Bắt đầu từ mẫu có sẵn trong VelcliHub.',s:[
  {t:'Chọn template',p:'Mở <b>VelcliHub</b>, chọn Next.js Blog, AI Chatbot hoặc Portfolio.'},
  {t:'Deploy',p:'Bấm <b>Deploy</b> để nhân bản và phát hành chỉ với một chạm.'}]}],
 note:'Các lệnh trong tài liệu mang tính minh họa. Hãy đối chiếu với mã nguồn trong repository trước khi phát hành.'},
{id:'agent',g:'Tính năng',t:'AI Agent',lead:'Agent lập kế hoạch, tạo và sửa file, chạy build rồi báo kết quả.',tabs:[
 {n:'Tạo ứng dụng',i:'Mô tả càng rõ, kết quả càng sát ý bạn.',s:[
  {t:'Viết yêu cầu',p:'Nêu công nghệ và chức năng chính.',c:T('Prompt','Tạo ứng dụng blog fullstack với Next.js, Tailwind và PostgreSQL')},
  {t:'Nhận kết quả',p:'Agent trả về bản xem trước và mã nguồn để bạn chỉnh tiếp.'}]},
 {n:'Chỉnh sửa',i:'Tiếp tục hội thoại để thay đổi ứng dụng.',s:[
  {t:'Yêu cầu thay đổi',p:'Nói rõ phần cần sửa.',c:T('Prompt','Thêm trang đăng nhập và đổi màu chủ đạo sang xanh dương')}]}]},
{id:'workspace',g:'Tính năng',t:'Workspace',lead:'Editor, Files và Terminal trong một giao diện, tối ưu cho điện thoại.',tabs:[
 {n:'Explorer',i:'Duyệt và mở file của dự án.',s:[
  {t:'Mở file',p:'Chọn file trong Explorer, nội dung hiện ở Editor.',c:T('app/page.tsx','export default function Home() {\n  return <h1>Xin chào VelCli</h1>;\n}',[1])},
  {t:'Lưu thay đổi',p:'Bấm <b>Lưu file</b> để ghi lại.'}]},
 {n:'Terminal',i:'Chạy lệnh ngay trong trình duyệt.',s:[
  {t:'Cài và chạy',p:'Cài thư viện rồi bật máy chủ.',c:T('Terminal','npm install\nnpm run dev')}]}]},
{id:'host',g:'Tính năng',t:'VelclawHost',lead:'Deploy và hosting tự động qua ba bước: Build, Deploy, Live.',tabs:[
 {n:'Deploy',i:'Phát hành dự án chỉ với một chạm.',s:[
  {t:'Chọn dự án và nhánh',p:'Nhập <b>Project Name</b> và chọn nhánh, ví dụ <code>main</code>.'},
  {t:'Bấm Deploy',p:'Theo dõi các bước Build, Deploy rồi Live. Khi hoàn tất, ứng dụng đã trực tuyến.'}]},
 {n:'Nhánh',i:'Mỗi nhánh có thể deploy riêng.',s:[
  {t:'Chuyển nhánh',p:'Đổi nhánh trước khi deploy để thử tính năng mới.',c:T('Terminal','git checkout -b dev')}]}]},
{id:'hub',g:'Tính năng',t:'VelcliHub',lead:'Kho template và cộng đồng để bắt đầu nhanh hơn.',tabs:[
 {n:'Template',i:'Các mẫu phổ biến.',s:[
  {t:'Chọn mẫu',p:'Next.js Blog, AI Chatbot, Portfolio. Mỗi mẫu có nút <b>Deploy</b>.'}]},
 {n:'Chia sẻ',i:'Đóng góp cho cộng đồng.',s:[
  {t:'Đăng mẫu của bạn',p:'Chia sẻ dự án thành template để người khác dùng lại.'}]}]},
{id:'plugins',g:'Tính năng',t:'Plugins',lead:'Mở rộng tính năng cho dự án chỉ bằng một công tắc.',tabs:[
 {n:'GitHub',i:'Kết nối repository.',s:[{t:'Bật plugin',p:'Vào Plugins, bật <b>GitHub Integration</b> và cấp quyền truy cập.'}]},
 {n:'Database',i:'PostgreSQL hoặc MongoDB.',s:[{t:'Kết nối',p:'Bật <b>Database</b> và chọn loại cơ sở dữ liệu.',c:T('.env','DATABASE_URL="postgresql://user:pass@host/db"',[0])}]},
 {n:'AI Models',i:'OpenAI, Gemini hoặc Groq.',s:[{t:'Chọn mô hình',p:'Bật <b>AI Models</b> và chọn nhà cung cấp cho AI Agent.'}]}]}
];
const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;');
function hl(l){let x=esc(l);x=x.replace(/^(\s*)(npm|velcli|cd|git)\b/,'$1<span class="k">$2</span>');return x.replace(/"[^"]*"/g,m=>'<span class="s">'+m+'</span>')}
function code(c){return '<div class="term"><div class="th"><span class="mono">'+c.l+'</span><button class="cp" aria-label="Sao chép">⧉</button></div><pre class="mono">'+c.c.split('\n').map((l,i)=>'<i'+((c.hi||[]).includes(i)?' class="h"':'')+'>'+hl(l)+'</i>').join('')+'</pre></div>'}
let cur=0,tab=0;
function side(){let h='',g='';P.forEach(p=>{if(p.g!==g){g=p.g;h+='<h4>'+g+'</h4>'}h+='<a href="#/'+p.id+'" class="'+(p.id===P[cur].id?'on':'')+'">'+p.t+'</a>'});$('#side').innerHTML=h}
function render(){
 const p=P[cur],t=p.tabs[tab];
 $('#bc').innerHTML=p.g+' › <b>'+p.t+'</b>';
 let h='<h1>'+p.t+'</h1><p class="lead">'+p.lead+'</p><h2>Cài đặt</h2><div class="tabs">'+p.tabs.map((x,i)=>'<button data-t="'+i+'" class="'+(i===tab?'on':'')+'">'+x.n+'</button>').join('')+'</div><p>'+t.i+'</p>';
 t.s.forEach((s,i)=>{h+='<div class="step"><span class="num">0'+(i+1)+'</span><div><h3>'+s.t+'</h3><p>'+s.p+'</p>'+(s.c?code(s.c):'')+'</div></div>'});
 if(p.note)h+='<div class="note">'+p.note+'</div>';
 const a=P[cur-1],b=P[cur+1];
 h+='<div class="pn">'+(a?'<a href="#/'+a.id+'"><small>← Trước</small><b>'+a.t+'</b></a>':'<span style="flex:1"></span>')+(b?'<a href="#/'+b.id+'"><small>Tiếp →</small><b>'+b.t+'</b></a>':'<span style="flex:1"></span>')+'</div>';
 $('#doc').innerHTML=h;side();
}
function route(){const id=location.hash.replace(/^#\/?/,'')||'start';const i=P.findIndex(p=>p.id===id);cur=i<0?0:i;tab=0;render();scrollTo(0,0);menu(false);document.title=P[cur].t+' – VelCli'}
function menu(o){$('#side').classList.toggle('open',o);$('#veil').hidden=!o}
$('#mo').onclick=()=>menu(true);$('#veil').onclick=()=>menu(false);
$('#doc').addEventListener('click',e=>{
 const tb=e.target.closest('[data-t]');if(tb){tab=+tb.dataset.t;render();return}
 const b=e.target.closest('.cp');if(b){const t=b.closest('.term').querySelector('pre').innerText;(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>{b.textContent='✓'},()=>{b.textContent='!'});setTimeout(()=>b.textContent='⧉',1400)}});
function sr(q){q=q.toLowerCase().trim();let h='';P.forEach(p=>{const txt=(p.t+' '+p.lead+' '+p.tabs.map(x=>x.n+' '+x.i).join(' ')).toLowerCase();if(!q||txt.includes(q))h+='<a href="#/'+p.id+'"><b>'+p.t+'</b><small>'+p.lead+'</small></a>'});$('#sl').innerHTML=h||'<p style="padding:12px 0">Không tìm thấy kết quả.</p>'}
$('#so').onclick=()=>{$('#sr').hidden=false;sr('');$('#si').focus()};
$('#sc').onclick=()=>$('#sr').hidden=true;
$('#si').oninput=e=>sr(e.target.value);
$('#sl').onclick=e=>{if(e.target.closest('a'))$('#sr').hidden=true};
addEventListener('hashchange',route);route();
</script>
</body>
</html>
