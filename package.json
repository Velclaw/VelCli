{
  "name": "velcli",
  "version": "0.1.0",
  "private": true,
  "description": "VelCli — next-generation autonomous engineering agent by Velclaw",
  "type": "module",
  "scripts": {
    "dev": "tsx apps/api/src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc && mkdir -p dist/apps/web && cp apps/web/index.html dist/apps/web/index.html",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "start": "node dist/apps/api/src/index.js"
  },
  "dependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^16.4.7",
    "openai": "^5.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5"
  }
}
